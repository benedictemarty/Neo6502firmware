# ***************************************************************************************
# ***************************************************************************************
#
#      Name :      fr.locale
#      Authors :   bmarty (bmarty@mailo.com)
#      Date :      18th September 2026
#      Reviewed :  No
#      Purpose :   FR keyboard locale file : PC AZERTY (French ISO keyboard), same table
#                  as layouts/fr.kmap of Neo6502kbd. Accented characters and symbols use
#                  their Latin-1 codes : glyphs $A0-$BF are built in and $C0-$FF are the
#                  defaults of the user defined font (F-17). The Apple French layout
#                  (upstream fr.locale) is fm.locale. Dead keys (^ ¨) give the plain
#                  character.
#
# ***************************************************************************************
# ***************************************************************************************
#
#		Unshifted keys : letters swapped, symbols on the number row.
#
[noshift]
    20:a
    26:z
    4:q
    29:w
    51:m
    16:,

    53:178                # ²
    30:&
    31:233                # é
    32:"
    33:'
    34:(
    35:-
    36:232                # è
    37:_
    38:231                # ç
    39:224                # à
    45:)
    46:=
    47:^
    48:$
    49:*
    50:*
    52:249                # ù
    54:;
    55:58                 # :
    56:!
    100:<
#
#		Shifted keys : digits on the number row, capitals.
#
[shift]
    20:A
    26:Z
    4:Q
    29:W
    51:M
    16:?

    30:1
    31:2
    32:3
    33:4
    34:5
    35:6
    36:7
    37:8
    38:9
    39:0
    45:176                # °
    46:+
    47:168                # ¨
    48:163                # £
    49:181                # µ
    50:181                # µ
    52:%
    54:.
    55:/
    56:167                # §
    100:>
#
#		ASCII codes generated by ALT-Keystroke : same as ALT-GR (one modifier on some keyboards)
#
[alt]
    31:~
    32:35                 # #
    33:{
    34:[
    35:|
    36:96                 # `
    37:92                 # backslash
    38:^
    39:@
    45:]
    46:}
    48:164                # ¤
#
#		ASCII codes generated by ALT-GR-keystroke
#
[altgr]
    31:~
    32:35                 # #
    33:{
    34:[
    35:|
    36:96                 # `
    37:92                 # backslash
    38:^
    39:@
    45:]
    46:}
    48:164                # ¤

# ***************************************************************************************
#
#		For each key, there are two values seperated by a colon.
#
#		The first is the key code which is the same as the USB packet.	An easy way to get
#		these is to run the demo "keyboard.bas" which will (after the 5 key bit) show you
#		the number of the keys that are pressed.
#
#		The second is either the ASCII character to send, *or* the ASCII value to send (values 0-9 are
#		assumed to be characters, 160-255 are Latin-1)
#
#		Anything with a # following it is assumed to be a comment. To remap # use its
# 		ASCII code (35)
#
# ***************************************************************************************
