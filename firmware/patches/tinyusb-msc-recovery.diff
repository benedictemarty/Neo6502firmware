+// Trinity T-168 : give up the command under way (no completion callback) and free both bulk endpoints
+bool tuh_msc_abort(uint8_t daddr, uint8_t* itf_num, uint8_t* ep_in, uint8_t* ep_out) {
+  msch_interface_t* p_msc = get_itf(daddr);
+  TU_VERIFY(p_msc->configured);
+
+  p_msc->stage = MSC_STAGE_IDLE;
+  p_msc->complete_cb = NULL;
+  (void) tuh_edpt_abort_xfer(daddr, p_msc->ep_in); // false when the endpoint carries nothing
+  (void) tuh_edpt_abort_xfer(daddr, p_msc->ep_out);
+
+  *itf_num = p_msc->itf_num;
+  *ep_in = p_msc->ep_in;
+  *ep_out = p_msc->ep_out;
+  return true;
+}
