+// Trinity T-168 : drop the transfer queued or under way on EPX (control or bulk ; interrupt endpoints are not handled).
+// Stopping EPX under a transaction may lose a packet and leave the data toggles out of step : the caller must reset the
+// transport and the toggles afterwards (USB key : Reset Recovery).
 bool hcd_edpt_abort_xfer(uint8_t rhport, uint8_t dev_addr, uint8_t ep_addr) {
   (void)rhport;
-  (void)dev_addr;
-  (void)ep_addr;
-  // TODO not implemented yet
-  return false;
+
+  hw_endpoint_t *ep = edpt_find(dev_addr, ep_addr);
+  TU_VERIFY(ep && ep->interrupt_num == 0);
+
+  rp2usb_critical_enter();
+  if (ep == epx && ep->state == EPSTATE_ACTIVE) {
+    sie_stop_xfer();
+    usbh_dpram->epx_buf_ctrl = 0;
+    usb_hw_clear->buf_status = 1u;
+    usb_hw_clear->sie_status =
+      USB_SIE_STATUS_RX_TIMEOUT_BITS | USB_SIE_STATUS_TRANS_COMPLETE_BITS | USB_SIE_STATUS_STALL_REC_BITS;
+  #ifndef HAS_STOP_EPX_ON_NAK
+    epx_switch_request = false;
+  #endif
+    rp2usb_reset_transfer(ep);
+    hw_endpoint_t *next_ep = epx_next_pending(ep);
+    if (next_ep != NULL) {
+      epx_switch_ep(next_ep);
+    }
+  } else if (ep->state != EPSTATE_IDLE) {
+    rp2usb_reset_transfer(ep); // waiting for EPX : never started
+  }
+  rp2usb_critical_exit();
+
+  return true;
 }
 
